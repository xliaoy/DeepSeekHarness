  "command_vocab": {
    "web": [
      "curl -s -o /dev/null -w '%{http_code}' http://TARGET/",
      "ffuf -u http://TARGET/FUZZ -w WORDLIST -mc 200,301,302,403 -ac",
      "gobuster dir -u http://TARGET -w WORDLIST -x php,asp,aspx,bak -t 20",
      "nuclei -u http://TARGET -t http/ -severity medium,high -stats",
      "sqlmap -u 'http://TARGET/item?id=1' --batch --level 3 --risk 2",
      "gobuster vhost -u http://TARGET -w WORDLIST --append-domain",
      "mitmproxy -p 8080 -w /tmp/flows.mitm",
      "curl -s -i http://TARGET/api/user/1 | head -40",
      "ffuf -u http://TARGET/api?name=FUZZ -w WORDLIST -fs 0 -mc all"
    ],
    "mobile": [
      "apktool d -f -o /tmp/out PKG.apk",
      "jadx -d /tmp/out --deobf PKG.apk",
      "frida -U -f PKG -l hook.js --no-pause",
      "objection -g PKG explore -s 'android sslpinning disable'",
      "adb shell pm path PKG",
      "apksigner verify --print-certs PKG.apk",
      "frida-ps -Uai | grep -i TARGET",
      "unzip -l PKG.apk | grep -E 'dex|\\.so$'",
      "keytool -printcert -jarfile PKG.apk"
    ],
    "miniprogram": [
      "node wuWxapkg.js -o /tmp/out FILE.wxapkg",
      "unveilr -o /tmp/out PKG.wxapkg",
      "mitmproxy -p 8080 --mode local -w /tmp/wx.mitm",
      "frida -U -f PKG -l hook.js --no-pause",
      "asar extract app.asar /tmp/out",
      "openssl x509 -in FILE -noout -subject -dates",
      "python3 -m http.server 8000 --directory /tmp/out"
    ],
    "game": [
      "Il2CppDumper libil2cpp.so global-metadata.dat /tmp/out",
      "frida -U -f PKG -l il2cpp.js --no-pause",
      "frida-trace -U -f PKG -i '*Coin*' -i '*Health*'",
      "readelf -S libil2cpp.so | grep -iE 'text|data'",
      "objdump -d --start-address=0x0 --stop-address=0x200 libil2cpp.so",
      "strings -n 6 libil2cpp.so | grep -iE 'Coin|Gem|Damage'",
      "xxd -s 0x1000 -l 128 FILE",
      "rabin2 -zz libil2cpp.so | head -40"
    ],
    "kernel": [
      "readelf -h FILE | head -20",
      "grep -i 'sys_call_table' /proc/kallsyms | head",
      "bpftrace -e 'kprobe:do_sys_open { printf(\"%s\\n\", comm); }'",
      "dmesg -T | tail -50",
      "modinfo TARGET.ko",
      "insmod ./TARGET.ko && lsmod | grep TARGET",
      "objdump -d --section=.text FILE | head -60",
      "pahole -C task_struct FILE | head -40"
    ],
    "firmware": [
      "binwalk -eM FILE.bin -C /tmp/out",
      "unblob -e /tmp/out FILE.img",
      "unsquashfs -d /tmp/rootfs FILE.squashfs",
      "flashrom -p ch341a_spi -r FILE.bin",
      "openocd -f interface/jlink.cfg -f target/TARGET.cfg",
      "qemu-mipsel-static -L /tmp/rootfs ./sbin/TARGET",
      "strings -n 8 FILE.bin | grep -iE 'passwd|admin'",
      "ubireader_extract_images FILE.ubi"
    ]
  },
  "toolchain_extra": {
    "web": [
      "gobuster — 目录/DNS/虚拟主机爆破（dir、vhost、-x、-w） | 装: apt install gobuster（或 go install github.com/OJ/gobuster/v3@latest）| 验: gobuster version",
      "dirsearch — 目录与备份文件扫描（-u、-e、--exclude-status） | 装: pipx install dirsearch | 验: dirsearch --version",
      "dalfox — XSS 参数扫描（url、pipe、--waf-evasion） | 装: go install github.com/hahwul/dalfox/v2@latest | 验: dalfox version",
      "nikto — 服务端配置与已知问题扫描（-h、-ssl、-Tuning） | 装: apt install nikto | 验: nikto -Version",
      "wpscan — WordPress 专项枚举（--enumerate、-e vp、--api-token） | 装: apt install wpscan（或 gem install wpscan）| 验: wpscan --version"
    ],
    "mobile": [
      "dex2jar — DEX 转 JAR 交给 JD-GUI 精读（d2j-dex2jar.sh -f -o） | 装: 官方 release zip（github.com/pxb1988/dex2jar）| 验: d2j-dex2jar.sh --version",
      "baksmali / smali — smali 反汇编与回编（baksmali d、smali a、--use-locals） | 装: 官方 release jar（github.com/google/smali）| 验: java -jar baksmali.jar --version",
      "apksigner — 签名校验与重签（verify --print-certs、sign --ks） | 装: apt install apksigner | 验: apksigner --version",
      "drozer — 组件暴露与 IPC 测试（run app.package.attacksurface、app.activity.info） | 装: pipx install drozer（agent apk 版本须一致）| 验: drozer --version",
      "Magisk / LSPosed — 系统级 Hook 与 zygisk 模块（模块刷入、DenyList、作用域） | 装: 官方 release zip 经 recovery 刷入 | 验: adb shell magisk -V"
    ],
    "miniprogram": [
      "unveilr — 新版 wxapkg 解包（-o、--no-clean、支持分包） | 装: npm i -g unveilr | 验: unveilr --version",
      "Frida + frida-tools — 小程序运行时 Hook（frida -U -f、-l script.js） | 装: pipx install frida-tools | 验: frida --version",
      "openssl — 自签根证书与证书查看（req -x509 -newkey、x509 -noout -subject） | 装: apt install openssl | 验: openssl version"
    ],
    "game": [
      "ilspycmd — .NET/Mono 程序集反编译（-o、-p、--nested-directories） | 装: dotnet tool install -g ilspycmd | 验: ilspycmd --version",
      "rizin — 定位 IL2CPP/native 函数与交叉引用（aa、axt、pdf） | 装: apt install rizin（或官方 release）| 验: rizin -v",
      "unicorn-engine — 模拟执行游戏函数做离线验证（Uc、mem_write、emu_start） | 装: python3 -m pip install unicorn | 验: python3 -c 'import unicorn; print(unicorn.__version__)'"
    ],
    "kernel": [
      "dwarves (pahole) — 内核结构体布局还原（pahole -C task_struct、-J） | 装: apt install dwarves | 验: pahole --version",
      "bpftool — eBPF 程序与 BTF 检视（prog list、btf dump、map show） | 装: apt install bpftool libbpf-dev | 验: bpftool version",
      "trace-cmd — ftrace 前端抓内核调用链（record -p function、report） | 装: apt install trace-cmd | 验: trace-cmd --version",
      "kexec-tools — 捕获内核与转储启动（kdump、kexec -l） | 装: apt install kexec-tools | 验: kexec --version"
    ],
    "firmware": [
      "openocd — 片上调试与 flash 读写（-f interface/、-f target/、program） | 装: apt install openocd | 验: openocd --version",
      "qemu-user-static — 跨架构直接跑固件二进制（qemu-mipsel-static -L、-strace） | 装: apt install qemu-user-static | 验: qemu-mipsel-static --version",
      "u-boot-tools — U-Boot 镜像头处理（mkimage -l、dumpimage -l） | 装: apt install u-boot-tools | 验: mkimage -V",
      "squashfs-tools — squashfs 解包与重打包（unsquashfs -d、mksquashfs -comp） | 装: apt install squashfs-tools | 验: unsquashfs -version",
      "device-tree-compiler — 设备树反编译（dtc -I dtb -O dts -o） | 装: apt install device-tree-compiler | 验: dtc --version"
    ]
  }
}
