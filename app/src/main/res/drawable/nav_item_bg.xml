<?xml version="1.0" encoding="utf-8"?>
<!-- Telegram 风格底栏选中态：深色圆角胶囊（内缩于悬浮条内，未选中透明）。
     day: 黑胶囊 + 白图标文字；night: 白胶囊 + 深色图标文字（primary/accent_on 自动随主题反转）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="6dp" android:insetTop="6dp" android:insetRight="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/primary" />
                <corners android:radius="@dimen/radius_pill" />
            </shape>
        </inset>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
