<?xml version="1.0" encoding="utf-8"?>
<!-- 引导第 3 页：三步上手。版式与第 2 页保持同一套语言（标题 + 灰副标题 + 白卡步骤），
     底部贴一条灰色提示，提示解压期间保持前台。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad_wide"
        android:paddingEnd="@dimen/page_pad_wide"
        android:paddingTop="@dimen/gap_section"
        android:paddingBottom="@dimen/gap_section">

        <TextView
            style="@style/DeepSeekHarnessText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="三步上手" />

        <TextView
            style="@style/DeepSeekHarnessText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:layout_marginBottom="@dimen/gap_section"
            android:gravity="center"
            android:text="内置环境会自动解压，填 key 就能用；没有 key 也能先装" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_control"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_pad">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/gap_control"
                android:background="@drawable/bg_chip"
                android:elevation="1dp"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="等环境解压完"
                    android:textStyle="bold" />

                <TextView
                    style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:text="下一页会自动解压内置 Linux 环境，不用自己装" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_control"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_pad">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/gap_control"
                android:background="@drawable/bg_chip"
                android:elevation="1dp"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="填入 API key（可跳过）"
                    android:textStyle="bold" />

                <TextView
                    style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:text="到「设置 → 配置」填入；也可跳过，之后在 WebUI 里配置第三方 API" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_section"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_pad">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/gap_control"
                android:background="@drawable/bg_chip"
                android:elevation="1dp"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="启动 Web UI"
                    android:textStyle="bold" />

                <TextView
                    style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:text="到「启动」页启动即可使用" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/DeepSeekHarnessText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="解压时请保持屏幕常亮，不要杀后台。" />
    </LinearLayout>
</ScrollView>
