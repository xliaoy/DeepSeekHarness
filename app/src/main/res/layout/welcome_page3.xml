<?xml version="1.0" encoding="utf-8"?>
<!-- 引导第 3 页：三步上手。版式与第 2 页保持同一套语言（标题 + 灰副标题 + 白卡步骤），
     底部贴一条灰色提示，提示解压期间保持前台。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad_wide"
        android:paddingEnd="@dimen/page_pad_wide"
        android:paddingTop="@dimen/gap_section"
        android:paddingBottom="@dimen/gap_section">

        <TextView
            style="@style/DeepSeekHarnessText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/welcome_p3_title" />

        <TextView
            style="@style/DeepSeekHarnessText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:layout_marginBottom="@dimen/gap_section"
            android:gravity="center"
            android:text="@string/welcome_p3_desc" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_control"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_pad">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/gap_control"
                android:background="@drawable/bg_chip"
                android:elevation="1dp"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_p3_step1"
                    android:textStyle="bold" />

                <TextView
                    style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:text="@string/welcome_p3_step1_desc" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_control"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_pad">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/gap_control"
                android:background="@drawable/bg_chip"
                android:elevation="1dp"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_p3_step2"
                    android:textStyle="bold" />

                <TextView
                    style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:text="@string/welcome_p3_step2_desc" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_section"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_pad">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/gap_control"
                android:background="@drawable/bg_chip"
                android:elevation="1dp"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_p3_step3"
                    android:textStyle="bold" />

                <TextView
                    style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:text="@string/welcome_p3_step3_desc" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/DeepSeekHarnessText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/welcome_p3_note" />
    </LinearLayout>
</ScrollView>
