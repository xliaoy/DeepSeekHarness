<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页：iOS 拟态分组卡片（模块 / 后台运行 / 其他） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad"
        android:paddingTop="@dimen/gap_tight"
        android:paddingBottom="@dimen/gap_section">

        <!-- 组：模块 -->
        <TextView
            style="@style/DeepSeekHarnessText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_hair"
            android:layout_marginBottom="@dimen/gap_tight"
            android:text="模块"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/settings_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="2dp"
            android:elevation="2dp" />

        <!-- 组：后台运行 -->
        <TextView
            style="@style/DeepSeekHarnessText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_hair"
            android:layout_marginTop="@dimen/gap_section"
            android:layout_marginBottom="@dimen/gap_tight"
            android:text="后台运行"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/settings_power"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="2dp"
            android:elevation="2dp" />

        <!-- 组：其他 -->
        <TextView
            style="@style/DeepSeekHarnessText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_hair"
            android:layout_marginTop="@dimen/gap_section"
            android:layout_marginBottom="@dimen/gap_tight"
            android:text="其他"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:elevation="2dp">

            <LinearLayout
                android:id="@+id/settings_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gap_block"
                android:paddingEnd="@dimen/gap_block"
                android:paddingTop="@dimen/gap_control"
                android:paddingBottom="@dimen/gap_control"
                android:minHeight="64dp">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="↻"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title"
                    android:elevation="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="更新 DeepSeek Harness"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settings_update_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="从 GitHub Releases 获取最新版本"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_label" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_title" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:layout_marginStart="@dimen/gap_block"
                android:layout_marginEnd="@dimen/gap_block"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/settings_selftest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gap_block"
                android:paddingEnd="@dimen/gap_block"
                android:paddingTop="@dimen/gap_control"
                android:paddingBottom="@dimen/gap_control"
                android:minHeight="64dp">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title"
                    android:elevation="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="诊断与日志"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="下载错误日志 · 环境检查 · 故障修复"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_label" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_title" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:layout_marginStart="@dimen/gap_block"
                android:layout_marginEnd="@dimen/gap_block"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/settings_reextract"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gap_block"
                android:paddingEnd="@dimen/gap_block"
                android:paddingTop="@dimen/gap_control"
                android:paddingBottom="@dimen/gap_control"
                android:minHeight="64dp">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="⟳"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title"
                    android:elevation="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_control"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="重新解压内置环境"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_hair"
                        android:text="dsh / npm 损坏时用；配置与对话记录会保留"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_label" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_title" />
            </LinearLayout>
        </LinearLayout>

        <!-- 组：源设置 -->
        <TextView
            style="@style/DeepSeekHarnessText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_hair"
            android:layout_marginTop="@dimen/gap_section"
            android:layout_marginBottom="@dimen/gap_tight"
            android:text="镜像与源"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/settings_sources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:elevation="2dp"
            android:paddingStart="@dimen/gap_block"
            android:paddingEnd="@dimen/gap_block"
            android:paddingTop="@dimen/gap_control"
            android:paddingBottom="@dimen/gap_control"
            android:minHeight="64dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="⇄"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_title"
                android:elevation="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="源设置"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:text="npm · Ubuntu 软件包(APT) · pip 镜像切换"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/settings_ver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_block"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="DeepSeekHarness"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</ScrollView>
