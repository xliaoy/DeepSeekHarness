<?xml version="1.0" encoding="utf-8"?>
<!--
  更新页：iOS 拟态分组排版。
  顶部导航行（返回 + 页标题），下面两张白色大圆角卡片：当前版本、检查与更新；
  版本说明单独成卡（默认 gone，由 UpdateUi 控制显隐）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/gap_control"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/gap_section">

        <!-- 导航行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_min"
            android:orientation="horizontal">

            <Button
                android:id="@+id/update_back"
                style="@style/Widget.DeepSeekHarness.ToolbarAction"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:contentDescription="@string/common_back"
                android:text="‹"
                android:textSize="@dimen/text_display" />

            <TextView
                style="@style/DeepSeekHarnessText.PageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_tight"
                android:layout_weight="1"
                android:text="@string/update_title" />
        </LinearLayout>

        <!-- ================= 当前版本 ================= -->
        <LinearLayout
            style="@style/DeepSeekHarnessCard"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_block">

            <TextView
                style="@style/DeepSeekHarnessText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/update_current_version" />

            <TextView
                android:id="@+id/update_current"
                style="@style/DeepSeekHarnessText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_hair" />

            <TextView
                style="@style/DeepSeekHarnessText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:text="@string/update_desc"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <!-- ================= 检查与更新 ================= -->
        <LinearLayout
            style="@style/DeepSeekHarnessCard"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section">

            <TextView
                style="@style/DeepSeekHarnessText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/update_result" />

            <TextView
                android:id="@+id/update_status"
                style="@style/DeepSeekHarnessText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:textIsSelectable="true" />

            <ProgressBar
                android:id="@+id/update_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/progress_bold"
                android:layout_marginTop="@dimen/gap_control"
                android:max="100"
                android:progressDrawable="@drawable/progress_determinate"
                android:visibility="gone" />

            <!-- 进度百分比文本：必须保留 -->
            <TextView
                android:id="@+id/update_progress_text"
                style="@style/DeepSeekHarnessText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 主操作：整行实心 -->
            <Button
                android:id="@+id/update_update"
                style="@style/Widget.DeepSeekHarness.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:minHeight="@dimen/btn_height"
                android:text="@string/update_apply"
                android:visibility="gone" />

            <!-- 次操作：描边按钮，避免与主操作抢视觉 -->
            <Button
                android:id="@+id/update_check"
                style="@style/Widget.DeepSeekHarness.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:minHeight="@dimen/btn_height"
                android:text="@string/update_check" />
        </LinearLayout>

        <Button
            android:id="@+id/update_browser"
            style="@style/Widget.DeepSeekHarness.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:text="@string/update_view_releases" />

        <!-- ================= 版本说明 ================= -->
        <LinearLayout
            android:id="@+id/update_notes_panel"
            style="@style/DeepSeekHarnessCard"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:visibility="gone">

            <TextView
                style="@style/DeepSeekHarnessText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/update_changelog" />

            <TextView
                android:id="@+id/update_notes"
                style="@style/DeepSeekHarnessText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:textIsSelectable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
