<?xml version="1.0" encoding="utf-8"?>
<!-- 欢迎/引导容器：内容区（ViewPager2）+ 页码指示 + 底部主按钮。
     纵向三段式；根背景与各引导页同为 surface，翻页时底色不跳变。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/welcome_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 页码指示：3 页引导的进度提示（圆点由 WelcomeActivity 动态创建填充） -->
    <LinearLayout
        android:id="@+id/welcome_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:minHeight="@dimen/gap_block"
        android:orientation="horizontal"
        android:paddingTop="@dimen/gap_hair"
        android:paddingBottom="@dimen/gap_control" />

    <!-- 底部主按钮：与引导页正文共用同一条 32dp 留白基准线 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad_wide"
        android:paddingEnd="@dimen/page_pad_wide"
        android:paddingBottom="@dimen/gap_section">

        <Button
            android:id="@+id/welcome_btn"
            style="@style/Widget.DeepSeekHarness.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/btn_height"
            android:text="下一步"
            android:textAllCaps="false"
            android:textSize="@dimen/text_body" />
    </LinearLayout>
</LinearLayout>
