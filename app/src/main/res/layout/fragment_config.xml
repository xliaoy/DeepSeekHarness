<?xml version="1.0" encoding="utf-8"?>
<!-- 配置页：接口 / 显示与运行 / DNS（结构对齐官方 v0.1.5-rc2，样式用 DeepSeek Harness 拟态卡片） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_pad"
            android:paddingTop="@dimen/gap_control"
            android:paddingEnd="@dimen/page_pad"
            android:paddingBottom="@dimen/gap_section">

            <!-- 组：接口（API 密钥 + 高级：端口） -->
            <LinearLayout style="@style/DeepSeekHarnessCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp">

                <TextView style="@style/DeepSeekHarnessText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_api_key" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginTop="@dimen/gap_control"
                    android:layout_marginBottom="@dimen/gap_control"
                    android:background="@color/line" />

                <TextView style="@style/DeepSeekHarnessText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_api_key_label" />

                <TextView style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:text="@string/config_api_key_desc" />

                <EditText android:id="@+id/config_api_key" style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/input_height"
                    android:layout_marginTop="@dimen/gap_tight"
                    android:background="@drawable/bg_input"
                    android:hint="sk-..."
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:paddingStart="@dimen/gap_control"
                    android:paddingEnd="@dimen/gap_control" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginTop="@dimen/gap_control"
                    android:layout_marginBottom="@dimen/gap_tight"
                    android:background="@color/line" />

                <TextView android:id="@+id/config_adv_header" style="@style/DeepSeekHarnessText.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="@dimen/gap_tight"
                    android:paddingBottom="@dimen/gap_tight"
                    android:text="@string/config_advanced_port" />

                <LinearLayout android:id="@+id/config_adv_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView style="@style/DeepSeekHarnessText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/config_port" />

                    <EditText android:id="@+id/config_port" style="@style/DeepSeekHarnessText.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/input_height"
                        android:layout_marginTop="@dimen/gap_tight"
                        android:background="@drawable/bg_input"
                        android:hint="@string/config_port_hint"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:paddingStart="@dimen/gap_control"
                        android:paddingEnd="@dimen/gap_control" />

                    <TextView style="@style/DeepSeekHarnessText.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_control"
                        android:text="@string/config_port_desc" />
                </LinearLayout>
            </LinearLayout>

            <!-- 组：显示与运行 -->
            <LinearLayout style="@style/DeepSeekHarnessCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_section">

                <TextView style="@style/DeepSeekHarnessText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_display" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginTop="@dimen/gap_control"
                    android:layout_marginBottom="@dimen/gap_tight"
                    android:background="@color/line" />

                <CheckBox android:id="@+id/config_check_update" style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:paddingStart="@dimen/gap_tight"
                    android:text="@string/config_check_updates"  android:buttonTint="@color/checkbox_tint" />

                <TextView style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_marginBottom="@dimen/gap_tight"
                    android:text="@string/config_check_updates_desc" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:background="@color/line" />

                <CheckBox android:id="@+id/config_desktop_mode" style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:paddingStart="@dimen/gap_tight"
                    android:text="@string/config_desktop_layout"  android:buttonTint="@color/checkbox_tint" />

                <TextView style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_marginBottom="@dimen/gap_tight"
                    android:text="@string/config_desktop_layout_desc" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:background="@color/line" />

                <TextView style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gap_tight"
                    android:paddingEnd="@dimen/gap_tight"
                    android:paddingTop="@dimen/gap_tight"
                    android:paddingBottom="@dimen/gap_tight"
                    android:gravity="center_vertical"
                    android:text="@string/browser_description" />

                <CheckBox android:id="@+id/config_gecko_core"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:visibility="gone"
                    android:text="@string/config_compat_webview"
                    android:textColor="@color/text_secondary"
 android:buttonTint="@color/checkbox_tint" />

                <TextView android:id="@+id/config_gecko_hint" style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_marginBottom="@dimen/gap_tight"
                    android:text="@string/config_compat_webview_desc" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:background="@color/line" />

                <CheckBox android:id="@+id/config_proroot" style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:paddingStart="@dimen/gap_tight"
                    android:text="@string/config_proroot"  android:buttonTint="@color/checkbox_tint" />

                <TextView style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_marginBottom="@dimen/gap_tight"
                    android:text="@string/config_proroot_desc" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:background="@color/line" />

                <CheckBox android:id="@+id/config_lan_mode" style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:paddingStart="@dimen/gap_tight"
                    android:text="@string/config_lan_access"  android:buttonTint="@color/checkbox_tint" />

                <TextView style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_marginBottom="@dimen/gap_tight"
                    android:text="@string/config_lan_access_desc" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:background="@color/line" />

                <CheckBox android:id="@+id/config_overlay_stream" style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:paddingStart="@dimen/gap_tight"
                    android:text="@string/config_overlay_output"  android:buttonTint="@color/checkbox_tint" />

                <TextView style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_marginBottom="@dimen/gap_tight"
                    android:text="@string/config_overlay_output_desc" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginBottom="@dimen/gap_tight"
                    android:background="@color/line" />

                <TextView android:id="@+id/config_overlay_style" style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:background="@drawable/bg_chip_clickable"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/gap_control"
                    android:paddingEnd="@dimen/gap_control"
                    android:text="@string/config_overlay_settings"
                    android:elevation="1dp" />

                <TextView style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:layout_marginBottom="@dimen/gap_tight"
                    android:text="@string/config_overlay_settings_desc" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:background="@color/line" />

                <CheckBox android:id="@+id/config_confirm_shell" style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:paddingStart="@dimen/gap_tight"
                    android:text="@string/config_confirm_dangerous"  android:buttonTint="@color/checkbox_tint" />

                <TextView style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_marginBottom="@dimen/gap_tight"
                    android:text="@string/config_confirm_dangerous_desc" />

                <CheckBox android:id="@+id/config_rc6" style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:paddingStart="@dimen/gap_tight"
                    android:text="@string/config_harness_channel"
                    android:visibility="gone"  android:buttonTint="@color/checkbox_tint" />
            </LinearLayout>

            <TextView android:id="@+id/config_workspace_entry" style="@style/Widget.DeepSeekHarness.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/btn_height"
                android:layout_marginTop="@dimen/gap_section"
                android:background="@drawable/bg_action_plain"
                android:gravity="center"
                android:text="@string/config_open_backup" />

            <!-- 组：DNS 解析 -->
            <LinearLayout style="@style/DeepSeekHarnessCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_section">

                <TextView style="@style/DeepSeekHarnessText.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_dns" />

                <RadioGroup android:id="@+id/config_dns_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_control"
                    android:orientation="vertical">

                    <RadioButton android:id="@+id/dns_auto" style="@style/Widget.DeepSeekHarness.RadioButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:paddingTop="@dimen/gap_tight"
                        android:paddingBottom="@dimen/gap_tight"
                        android:text="@string/dns_auto_hint" />

                    <RadioButton android:id="@+id/dns_ipv4" style="@style/Widget.DeepSeekHarness.RadioButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:paddingTop="@dimen/gap_tight"
                        android:paddingBottom="@dimen/gap_tight"
                        android:text="@string/dns_ipv4_compat" />

                    <RadioButton android:id="@+id/dns_native" style="@style/Widget.DeepSeekHarness.RadioButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:paddingTop="@dimen/gap_tight"
                        android:paddingBottom="@dimen/gap_tight"
                        android:text="@string/dns_native_dual" />
                </RadioGroup>

                <TextView style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_control"
                    android:text="@string/dns_desc" />

                <TextView style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_section"
                    android:layout_marginStart="@dimen/gap_hair"
                    android:text="@string/config_ui_language"
                    android:textStyle="bold" />

                <RadioGroup android:id="@+id/config_ui_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_control"
                    android:orientation="horizontal">

                    <RadioButton android:id="@+id/lang_zh" style="@style/Widget.DeepSeekHarness.RadioButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/config_lang_zh" />

                    <RadioButton android:id="@+id/lang_en" style="@style/Widget.DeepSeekHarness.RadioButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="English" />
                </RadioGroup>

                <TextView style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:text="@string/config_lang_desc" />
            </LinearLayout>

            <TextView android:id="@+id/config_repo_link" style="@style/DeepSeekHarnessText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_section"
                android:gravity="center"
                android:text="DeepSeek Harness" />
        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/config_save" style="@style/Widget.DeepSeekHarness.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_tight"
        android:layout_marginBottom="@dimen/gap_tight"
        android:layout_marginStart="@dimen/page_pad"
        android:layout_marginEnd="@dimen/page_pad"
        android:text="@string/config_save"
        android:minHeight="@dimen/btn_height" />
</LinearLayout>