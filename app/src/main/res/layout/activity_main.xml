<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- ================= 主内容（EdgeSwipeLayout：左侧区域右滑展开侧边栏） ================= -->
    <com.deepseekharness.app.ui.EdgeSwipeLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/bg_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_pad"
            android:paddingEnd="@dimen/gap_control">

            <!-- 汉堡按钮：点击以侧边栏方式展示设置全部入口 -->
            <ImageView
                android:id="@+id/btn_menu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_action_plain"
                android:contentDescription="打开菜单"
                android:padding="10dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/text" />

            <TextView android:id="@+id/sub_back" style="@style/Widget.DeepSeekHarness.ToolbarAction"
                android:layout_width="44dp" android:layout_height="wrap_content" android:text="‹"
                android:textSize="24sp" android:contentDescription="返回上一页" android:visibility="gone" />

            <TextView
                android:id="@+id/app_title"
                style="@style/DeepSeekHarnessText.NavTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_control"
                android:text="@string/app_name" />

            <!-- 主题切换：纯图标（太阳/月亮），不显示文字 -->
            <ImageView
                android:id="@+id/btn_theme"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="@dimen/gap_tight"
                android:background="@drawable/bg_action_plain"
                android:contentDescription="切换白天黑夜"
                android:padding="10dp"
                android:src="@drawable/ic_sun"
                app:tint="@color/text" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/line" />

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Telegram 风格悬浮底栏：居中胶囊卡片，左右留白、底部悬浮、柔和阴影（elevation）。 -->
        <FrameLayout
            android:id="@+id/bottom_nav_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/nav_pad_x"
            android:paddingEnd="@dimen/nav_pad_x"
            android:paddingTop="6dp"
            android:paddingBottom="@dimen/nav_pad_y">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="@dimen/nav_height"
                android:background="@drawable/bg_nav_floating"
                android:elevation="8dp"
                app:itemActiveIndicatorStyle="@style/Widget.DeepSeekHarness.BottomNavActiveIndicator"
                app:itemBackground="@drawable/nav_item_bg"
                app:itemHorizontalTranslationEnabled="false"
                app:itemIconSize="24dp"
                app:itemIconTint="@color/nav_item_tint"
                app:itemPaddingTop="4dp"
                app:itemPaddingBottom="4dp"
                app:itemRippleColor="@color/ripple"
                app:itemTextColor="@color/nav_item_tint"
                app:itemTextAppearanceActive="@style/TextAppearance.DeepSeekHarness.NavLabelActive"
                app:itemTextAppearanceActiveBoldEnabled="true"
                app:itemTextAppearanceInactive="@style/TextAppearance.DeepSeekHarness.NavLabelInactive"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav_menu" />
        </FrameLayout>
    </LinearLayout>
    </com.deepseekharness.app.ui.EdgeSwipeLayout>

    <!-- ================= 侧边栏（设置入口集合，代码构建内容） ================= -->
    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/card"
        android:orientation="vertical" />
</androidx.drawerlayout.widget.DrawerLayout>