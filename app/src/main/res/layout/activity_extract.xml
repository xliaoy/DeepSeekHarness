<?xml version="1.0" encoding="utf-8"?>
<!--
  环境维护门禁页：居中式 iOS 拟态排版。
  顶部圆角图标卡（转圈）+ 页面大标题，状态/进度/详情收进一张白色大圆角卡片。
  注意：ExtractActivity 会把「重试 / 进入主界面」两个按钮动态 addView 到
  extract_status 的父容器（必须保持为垂直 LinearLayout）末尾，因此卡片末尾留了一个
  间距占位 View，避免动态按钮与详情文字贴死。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/page_pad">

        <FrameLayout
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp">

            <ProgressBar
                android:id="@+id/extract_bar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/extract_title"
            style="@style/DeepSeekHarnessText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_block"
            android:gravity="center"
            android:text="正在准备运行环境" />

        <!-- 状态卡片：extract_status 必须直接位于垂直 LinearLayout 中 -->
        <LinearLayout
            style="@style/DeepSeekHarnessCard"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section">

            <TextView
                android:id="@+id/extract_status"
                style="@style/DeepSeekHarnessText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="首次启动需要解压内置环境，请稍候…" />

            <ProgressBar
                android:id="@+id/extract_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/progress_bold"
                android:layout_marginTop="@dimen/gap_control"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/progress_determinate"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/extract_detail"
                style="@style/DeepSeekHarnessText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:fontFamily="monospace"
                android:gravity="center"
                android:visibility="invisible" />

            <!-- 间距占位：动态追加的「重试 / 进入主界面」按钮跟在它后面 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/gap_control" />
        </LinearLayout>

        <TextView
            android:id="@+id/extract_error"
            style="@style/DeepSeekHarnessText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:background="@drawable/bg_error_box"
            android:gravity="start"
            android:padding="@dimen/card_pad"
            android:textColor="@color/err"
            android:textIsSelectable="true"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
