<?xml version="1.0" encoding="utf-8"?>
<!-- 数据与备份页：结构对齐官方 v0.1.5-rc2（备份与恢复 / 工作区 / 文件共享 / 环境维护），样式用 DeepSeek Harness 拟态卡片 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_pad">

        <LinearLayout style="@style/DeepSeekHarnessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp">

            <TextView style="@style/DeepSeekHarnessText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/workspace_backup" />

            <TextView style="@style/DeepSeekHarnessText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_hair"
                android:text="@string/workspace_backup_desc" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:layout_marginTop="@dimen/gap_control"
                android:background="@color/line" />

            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_backup_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:layout_marginTop="@dimen/gap_control"
                android:saveEnabled="false"
                android:text="@string/workspace_backup_api_key"  />

            <TextView style="@style/DeepSeekHarnessText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_hair"
                android:text="@string/workspace_backup_api_key_desc" />

            <Button android:id="@+id/workspace_backup" style="@style/Widget.DeepSeekHarness.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:text="@string/workspace_create_backup" />

            <Button android:id="@+id/workspace_restore" style="@style/Widget.DeepSeekHarness.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:text="@string/workspace_restore_from_file" />

            <TextView android:id="@+id/workspace_backup_status" style="@style/DeepSeekHarnessText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control" />

            <Button android:id="@+id/workspace_restore_latest" style="@style/Widget.DeepSeekHarness.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_hair"
                android:text="@string/workspace_preview_backups" />

            <Button android:id="@+id/workspace_location" style="@style/Widget.DeepSeekHarness.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/workspace_backup_location" />

            <TextView style="@style/DeepSeekHarnessText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_hair"
                android:text="@string/workspace_backup_warning" />
        </LinearLayout>

        <LinearLayout style="@style/DeepSeekHarnessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section">

            <TextView style="@style/DeepSeekHarnessText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/workspace_title" />

            <TextView style="@style/DeepSeekHarnessText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_hair"
                android:text="@string/workspace_dir_desc" />

            <EditText android:id="@+id/workspace_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/input_height"
                android:layout_marginTop="@dimen/gap_control"
                android:background="@drawable/bg_input"
                android:padding="@dimen/gap_control"
                android:singleLine="true"
                android:hint="deepseek-harness" />

            <Button android:id="@+id/workspace_apply" style="@style/Widget.DeepSeekHarness.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:text="@string/workspace_app_path" />

            <TextView android:id="@+id/workspace_info" style="@style/DeepSeekHarnessText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:text="" />
        </LinearLayout>

        <LinearLayout style="@style/DeepSeekHarnessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section">

            <TextView style="@style/DeepSeekHarnessText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/workspace_file_share" />

            <TextView android:id="@+id/workspace_share_status" style="@style/DeepSeekHarnessText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:text="" />
        </LinearLayout>

        <LinearLayout style="@style/DeepSeekHarnessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section">

            <TextView style="@style/DeepSeekHarnessText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/env_maintenance" />

            <TextView style="@style/DeepSeekHarnessText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_hair"
                android:text="@string/workspace_maintenance_desc" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:layout_marginTop="@dimen/gap_control"
                android:background="@color/line" />

            <Button android:id="@+id/workspace_clean_sessions" style="@style/Widget.DeepSeekHarness.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:text="@string/workspace_clean_sessions" />

            <Button android:id="@+id/workspace_reset" style="@style/Widget.DeepSeekHarness.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:text="@string/workspace_reset_config" />

            <Button android:id="@+id/workspace_clear" style="@style/Widget.DeepSeekHarness.DangerButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:text="@string/workspace_clear_env" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>