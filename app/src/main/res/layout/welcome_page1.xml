<?xml version="1.0" encoding="utf-8"?>
<!-- 引导第 1 页：品牌页。上下弹性留白把「图标卡 + 大标题 + 说明」压在视觉中心，
     版本说明贴底；左右 32dp 大边距，对应 iOS 欢迎页的疏朗版式。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_pad_wide"
    android:paddingEnd="@dimen/page_pad_wide"
    android:paddingTop="@dimen/gap_section"
    android:paddingBottom="@dimen/gap_section">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 插图区：白色大圆角卡片做底托，内部再叠一层圆角图标底（bg_logo），
         双层圆角 + elevation 2dp 形成 iOS 图标卡片的层叠质感 -->
    <FrameLayout
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:background="@drawable/bg_card"
        android:elevation="2dp">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_logo">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        style="@style/DeepSeekHarnessText.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_section"
        android:gravity="center"
        android:letterSpacing="-0.02"
        android:text="DeepSeekHarness"
        android:textSize="@dimen/text_hero" />

    <TextView
        style="@style/DeepSeekHarnessText.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_block"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="@string/welcome_p1_title"
        android:textSize="@dimen/text_body" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        style="@style/DeepSeekHarnessText.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/edition_description" />
</LinearLayout>
