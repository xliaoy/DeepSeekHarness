<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/surface">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="14dp" android:paddingBottom="22dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_device_grants" android:textSize="24sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_grants_sub" android:textSize="12sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="7dp" android:layout_marginBottom="18dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_device_channels" android:textSize="11sp" android:textColor="@color/text_muted" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginBottom="12dp">
      <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_root_shell" style="@style/DeepSeekHarnessText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0062" android:layout_marginTop="8dp" android:textSize="13sp" android:paddingTop="6dp" android:paddingBottom="6dp" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui134_root_hint" android:textSize="11sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="8dp" />
      <TextView android:id="@+id/device_root_status" style="@style/DeepSeekHarnessText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginStart="0dp" android:padding="12dp" android:background="@drawable/bg_selection" android:text="@string/device_checking" android:maxLines="2" android:ellipsize="end" android:minHeight="0dp" />
      <TextView android:id="@+id/config_guard_status" style="@style/DeepSeekHarnessText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_tight" android:layout_marginTop="@dimen/gap_hair" android:visibility="gone" />
      <Button android:id="@+id/device_root_verify" style="@style/Widget.DEEPSEEK_HARNESS_Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ui_m0170" android:textColor="@color/primary" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginBottom="12dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Shizuku" android:textSize="14sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="12dp" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui134_shizuku_hint" android:textSize="11sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="8dp" />
      <TextView android:id="@+id/workspace_shizuku_status" style="@style/DeepSeekHarnessText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_m0039" android:layout_marginStart="0dp" android:padding="12dp" android:background="@drawable/bg_selection" android:maxLines="2" android:ellipsize="end" android:minHeight="0dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/workspace_shizuku_auth" style="@style/Widget.DEEPSEEK_HARNESS_Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginTop="0dp" android:text="@string/ui_m0015" android:textColor="@color/primary" android:layout_weight="1" android:textSize="12sp" />
        <Button android:id="@+id/device_shizuku_open" style="@style/Widget.DEEPSEEK_HARNESS_TextButton" android:layout_width="0dp" android:layout_height="match_parent" android:text="@string/ui_m0125" android:layout_weight="1" android:layout_marginTop="0dp" android:textSize="12sp" />
      </LinearLayout>
    </LinearLayout>
    <!-- Stellar（Shizuku 兼容分支）：java-port 回流 fork 的 Stellar 通道逻辑后，
         DeviceGrantsFragment 引用 device_stellar_status / device_stellar_auth 两个 id。
         结构与上游同款卡片（bg_card + 16dp 内边距），放在 Shizuku 之后、ADB 之前，与 fork 顺序一致。 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginBottom="12dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/grants_stellar" android:textSize="14sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="12dp" />
      <TextView android:id="@+id/device_stellar_status" style="@style/DeepSeekHarnessText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_tight" android:layout_marginStart="0dp" android:padding="12dp" android:background="@drawable/bg_selection" android:text="@string/grants_checking" android:maxLines="2" android:ellipsize="end" android:minHeight="0dp" />
      <Button android:id="@+id/device_stellar_auth" style="@style/Widget.DEEPSEEK_HARNESS_Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_control" android:minHeight="@dimen/btn_height" android:text="@string/grants_authorize_stellar" android:textColor="@color/primary" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginBottom="12dp">
      <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_adb_enable" style="@style/DeepSeekHarnessText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="48dp" android:paddingStart="0dp" android:text="@string/ui_m0090" android:textSize="13sp" android:paddingTop="6dp" android:paddingBottom="6dp" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui134_adb_hint" android:textSize="11sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="8dp" />
      <TextView android:id="@+id/config_adb_status" style="@style/DeepSeekHarnessText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_m0030" android:layout_marginStart="0dp" android:padding="12dp" android:background="@drawable/bg_selection" android:maxLines="2" android:ellipsize="end" android:minHeight="0dp" />
      <Button android:id="@+id/config_adb_pair" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_btn" android:text="@string/ui_m0031" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="@dimen/text_body" android:minHeight="@dimen/btn_height" style="@style/Widget.DEEPSEEK_HARNESS_Button" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Computer Use" android:textSize="11sp" android:textColor="@color/text_muted" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp">
      <TextView android:id="@+id/computer_use_hint" style="@style/DeepSeekHarnessText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" />
      <Button android:id="@+id/computer_use_accessibility" style="@style/Widget.DEEPSEEK_HARNESS_Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui134_screen_setup" />
      <TextView android:id="@+id/config_a11y_status" style="@style/DeepSeekHarnessText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="0dp" android:layout_marginTop="8dp" android:padding="12dp" android:background="@drawable/bg_selection" android:text="@string/device_checking" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_system_permissions" android:textSize="11sp" android:textColor="@color/text_muted" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp">
      <LinearLayout android:id="@+id/config_all_files" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="56dp" android:padding="12dp" android:layout_marginTop="12dp" android:background="@drawable/bg_polished_action" android:clickable="true" android:focusable="true">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/device_open_access" android:layout_marginTop="0dp" style="@style/DeepSeekHarnessText.Body" android:layout_weight="1" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_recovery_right" app:tint="@color/primary" android:importantForAccessibility="no" />
      </LinearLayout>
      <TextView android:id="@+id/config_all_files_status" style="@style/DeepSeekHarnessText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_muted" android:layout_marginTop="8dp" android:text="@string/device_checking" />
      <TextView android:id="@+id/config_battery_opt_hint" style="@style/DeepSeekHarnessText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_hair" android:text="@string/ui_m0084" />
      <Button android:id="@+id/config_battery_opt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_btn" android:text="@string/ui_m0191" android:textAllCaps="false" android:textColor="@color/primary" android:textSize="@dimen/text_body" android:minHeight="@dimen/btn_height" style="@style/Widget.DEEPSEEK_HARNESS_Button" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_sensitive" android:textSize="11sp" android:textColor="@color/text_muted" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp">
      <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/device_sms" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_m0171" android:textColor="@color/text" android:textSize="16sp" />
      <TextView android:id="@+id/device_sms_status" style="@style/DeepSeekHarnessText.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginStart="0dp" android:padding="12dp" android:background="@drawable/bg_selection" android:text="@string/device_checking" />
      <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_cap_location" style="@style/DeepSeekHarnessText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_m0066" android:minHeight="48dp" android:layout_marginTop="8dp" android:paddingStart="0dp" android:textSize="13sp" android:paddingTop="6dp" android:paddingBottom="6dp" />
      <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/config_cap_sensors" style="@style/DeepSeekHarnessText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_m0053" android:minHeight="48dp" android:layout_marginTop="8dp" android:paddingStart="0dp" android:textSize="13sp" android:paddingTop="6dp" android:paddingBottom="6dp" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
