<?xml version="1.0" encoding="utf-8"?>
<!-- 插件页：iOS 拟态卡片分组（分段控件 + 同步卡 + 安装卡 + 提示卡 + 列表） -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pluginScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_pad">
        <!-- 组标题：插件管理 -->
        <TextView
            style="@style/DeepSeekHarnessText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_hair"
            android:layout_marginBottom="@dimen/gap_tight"
            android:text="@string/plugins_title"
            android:textStyle="bold" />

        <!-- 管理与筛选卡（搜索 + 筛选 + 同步/检测更新） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="@dimen/card_pad">

            <EditText
                android:id="@+id/pluginSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/input_height"
                android:background="@drawable/bg_input"
                android:hint="@string/plugins_search_hint"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:padding="@dimen/gap_control"
                android:textColor="@color/text"
                android:textColorHint="@color/text_muted"
                android:textSize="@dimen/text_body" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:layout_marginTop="@dimen/gap_tight"
                android:layout_marginBottom="@dimen/gap_tight"
                android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pluginCount"
                    style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/btnSort"
                    style="@style/Widget.DeepSeekHarness.ToolbarAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:maxWidth="140dp"
                    android:text="@string/plugins_sort_name" />

                <TextView
                    android:id="@+id/btnRefresh"
                    style="@style/Widget.DeepSeekHarness.ToolbarAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:maxWidth="140dp"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:text="@string/plugins_sync_status" />

                <Button
                    android:id="@+id/btnPluginUpdates"
                    style="@style/Widget.DeepSeekHarness.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:text="@string/update_check" />
            </LinearLayout>
        </LinearLayout>

        <!-- 安装插件卡：在线安装 / 命令行安装 弹窗入口 -->
        <LinearLayout
            style="@style/DeepSeekHarnessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/DeepSeekHarnessText.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/plugin_install_title" />

                <TextView
                    android:id="@+id/btnPluginHelp"
                    style="@style/Widget.DeepSeekHarness.ToolbarAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="？"
                    android:contentDescription="@string/plugins_tip" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOnlineInstall"
                    style="@style/Widget.DeepSeekHarness.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/btn_height"
                    android:text="@string/plugins_online_install" />

                <Button
                    android:id="@+id/btnCommandInstallBtn"
                    style="@style/Widget.DeepSeekHarness.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_weight="1"
                    android:minHeight="@dimen/btn_height"
                    android:text="@string/plugins_cli_install" />
            </LinearLayout>
        </LinearLayout>


        <Button
            android:id="@+id/btnPluginRestore"
            style="@style/Widget.DeepSeekHarness.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:visibility="gone"
            android:text="@string/plugins_safe_mode" />

        <TextView
            android:id="@+id/pluginEmpty"
            style="@style/DeepSeekHarnessText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="@dimen/card_pad"
            android:gravity="center"
            android:visibility="gone"
            android:textColor="@color/text_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/gap_section"
            android:layout_marginBottom="@dimen/gap_tight"
            android:orientation="horizontal">

            <TextView
                style="@style/DeepSeekHarnessText.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/gap_hair"
                android:text="@string/plugins_list"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnImport"
                style="@style/Widget.DeepSeekHarness.ToolbarAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plugins_import" />

            <TextView
                android:id="@+id/btnExport"
                style="@style/Widget.DeepSeekHarness.ToolbarAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_tight"
                android:text="@string/plugins_export" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pluginList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:nestedScrollingEnabled="false"
            android:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
