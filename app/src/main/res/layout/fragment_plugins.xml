<?xml version="1.0" encoding="utf-8"?>
<!-- 插件页：拟态卡片分组（搜索筛选卡 + 安装卡 + 列表）
     ★ 结构 = 无商城版本（用户明确要求"不要有在线商城的那个"）
       · 已删除：分段控件（btnMarket/btnInstalled）、在线商城卡（pluginMarketCard）、
         社区入口（pluginWebsiteSection/btnPluginWebsite）
       · 保留：插件列表 + 在线安装 + 命令行安装
         （用户原话"只留插件列表和命令行安装，在线安装这个就行"）
     ★ 视觉 token 沿用本仓库命名形态（Widget.DEEPSEEK_HARNESS_*），
       不照抄参考实现的 Widget.DeepSeekHarness.*：
       本仓库 14 个 Widget.* 全部是大写下划线形态，混入驼峰会造出同族不一致（K7），
       且那 3 个驼峰名在本仓库并不存在 ⇒ 照抄必然 aapt2 编译失败。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pluginScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="22dp">
        <!-- 组标题：插件管理 -->
        <TextView
            style="@style/DeepSeekHarnessText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_hair"
            android:layout_marginBottom="@dimen/gap_tight"
            android:text="@string/plugins_title"
            android:includeFontPadding="false"
            android:textStyle="bold" />

        <!-- 管理与筛选卡（搜索 + 筛选 + 同步/检测更新） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_pad">

            <EditText
                android:id="@+id/pluginSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/input_height"
                android:background="@drawable/bg_input"
                android:hint="@string/plugins_search_hint"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:importantForAutofill="no"
                android:padding="@dimen/gap_control"
                android:textColor="@color/text"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp"
                android:drawableStart="@drawable/ic_ui_search"
                android:drawablePadding="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:layout_marginTop="@dimen/gap_tight"
                android:layout_marginBottom="@dimen/gap_tight"
                android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pluginCount"
                    style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/btnSort"
                    style="@style/Widget.DEEPSEEK_HARNESS_ToolbarAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:maxWidth="140dp"
                    android:text="@string/plugins_sort_name" />

                <TextView
                    android:id="@+id/btnRefresh"
                    style="@style/Widget.DEEPSEEK_HARNESS_ToolbarAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:maxWidth="140dp"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:text="@string/plugins_sync_status" />

                <TextView
                    android:id="@+id/btnPluginUpdates"
                    style="@style/Widget.DEEPSEEK_HARNESS_TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:text="@string/update_check" />
            </LinearLayout>
        </LinearLayout>

        <!-- 安装插件卡：在线安装 / 命令行安装 -->
        <LinearLayout
            style="@style/DeepSeekHarnessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/DeepSeekHarnessText.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/plugin_install_title" />

                <TextView
                    android:id="@+id/btnPluginHelp"
                    style="@style/Widget.DEEPSEEK_HARNESS_ToolbarAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:text="？"
                    android:contentDescription="@string/plugins_tip" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnOnlineInstall"
                    style="@style/Widget.DEEPSEEK_HARNESS_Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/plugins_online_install" />

                <TextView
                    android:id="@+id/btnCommandInstallBtn"
                    style="@style/Widget.DEEPSEEK_HARNESS_Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/plugins_cli_install" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnPluginRestore"
            style="@style/Widget.DEEPSEEK_HARNESS_Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:minHeight="52dp"
            android:visibility="gone"
            android:text="@string/plugins_safe_mode" />

        <TextView
            android:id="@+id/pluginEmpty"
            style="@style/DeepSeekHarnessText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:background="@drawable/bg_card"
            android:padding="@dimen/card_pad"
            android:gravity="center"
            android:visibility="gone"
            android:textColor="@color/text_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/gap_section"
            android:layout_marginBottom="@dimen/gap_tight"
            android:orientation="horizontal">

            <TextView
                style="@style/DeepSeekHarnessText.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/gap_hair"
                android:includeFontPadding="false"
                android:text="@string/plugins_list"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnImport"
                style="@style/Widget.DEEPSEEK_HARNESS_ToolbarAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_ui_import"
                android:drawablePadding="6dp"
                android:text="@string/plugins_import" />

            <TextView
                android:id="@+id/btnExport"
                style="@style/Widget.DEEPSEEK_HARNESS_ToolbarAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_tight"
                android:drawableStart="@drawable/ic_ui_export"
                android:drawablePadding="6dp"
                android:text="@string/plugins_export" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pluginList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:nestedScrollingEnabled="false"
            android:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
