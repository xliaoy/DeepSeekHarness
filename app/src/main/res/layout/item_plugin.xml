<?xml version="1.0" encoding="utf-8"?>
<!-- 插件列表项：iOS 拟态卡片（左：名称/描述/状态，右：开关 + 更多） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_control"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/card_pad"
    android:elevation="1dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/gap_control"
        android:orientation="vertical">

        <TextView android:id="@+id/pluginName" style="@style/DeepSeekHarnessText.Body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans" android:breakStrategy="simple"
            android:textStyle="bold" />

        <TextView android:id="@+id/pluginDesc" style="@style/DeepSeekHarnessText.Caption"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_hair" android:maxLines="3" android:ellipsize="end" />

        <TextView android:id="@+id/pluginStatus" style="@style/DeepSeekHarnessText.Caption"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_hair" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <Switch android:id="@+id/pluginSwitch" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_min"
            android:showText="false" />

        <TextView android:id="@+id/pluginActions" style="@style/PluginAction"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight" android:text="@string/plugin_item_more" />
    </LinearLayout>
</LinearLayout>
