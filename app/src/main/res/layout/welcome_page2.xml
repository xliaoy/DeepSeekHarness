<?xml version="1.0" encoding="utf-8"?>
<!-- 引导第 2 页：四个主页面导览。标题 + 灰色副标题 + 四张 iOS 拟态白卡（序号胶囊 + 双行说明）。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad_wide"
        android:paddingEnd="@dimen/page_pad_wide"
        android:paddingTop="@dimen/gap_section"
        android:paddingBottom="@dimen/gap_section">

        <TextView
            style="@style/DeepSeekHarnessText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="四个页面" />

        <TextView
            style="@style/DeepSeekHarnessText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight"
            android:layout_marginBottom="@dimen/gap_section"
            android:gravity="center"
            android:text="启动、终端、市场、设置，底栏一切换" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_control"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_pad">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/gap_control"
                android:background="@drawable/bg_chip"
                android:elevation="1dp"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="启动"
                    android:textStyle="bold" />

                <TextView
                    style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:text="启动 Web UI，点「进入」在软件里打开" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_control"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_pad">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/gap_control"
                android:background="@drawable/bg_chip"
                android:elevation="1dp"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="终端"
                    android:textStyle="bold" />

                <TextView
                    style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:text="进 Linux 环境敲命令" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_control"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_pad">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/gap_control"
                android:background="@drawable/bg_chip"
                android:elevation="1dp"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="市场"
                    android:textStyle="bold" />

                <TextView
                    style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:text="浏览、安装、开关插件" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_pad">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/gap_control"
                android:background="@drawable/bg_chip"
                android:elevation="1dp"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DeepSeekHarnessText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="设置"
                    android:textStyle="bold" />

                <TextView
                    style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_hair"
                    android:text="API key、安装、工作区、备份" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
