<?xml version="1.0" encoding="utf-8"?>
<!--
  插件安装确认页：iOS 拟态分组排版。
  顶部导航行 + 两张白色大圆角卡片：请求信息（状态 / 真实包信息）、操作。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/gap_control"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/gap_section">

        <!-- 导航行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_min"
            android:orientation="horizontal">

            <Button
                android:id="@+id/link_install_close"
                style="@style/Widget.DeepSeekHarness.ToolbarAction"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:contentDescription="@string/common_back"
                android:text="‹"
                android:textSize="@dimen/text_display" />

            <TextView
                style="@style/DeepSeekHarnessText.PageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_tight"
                android:layout_weight="1"
                android:text="@string/plugin_install_title" />
        </LinearLayout>

        <!-- ================= 请求信息 ================= -->
        <LinearLayout
            style="@style/DeepSeekHarnessCard"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_block">

            <TextView
                android:id="@+id/link_install_status"
                style="@style/DeepSeekHarnessText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke"
                android:layout_marginTop="@dimen/gap_control"
                android:background="@color/line" />

            <TextView
                android:id="@+id/link_install_details"
                style="@style/DeepSeekHarnessText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:textIsSelectable="true" />
        </LinearLayout>

        <!-- ================= 操作 ================= -->
        <LinearLayout
            style="@style/DeepSeekHarnessCard"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section">

            <Button
                android:id="@+id/link_install_confirm"
                style="@style/Widget.DeepSeekHarness.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/btn_height"
                android:text="@string/plugin_install_parse_link" />

            <Button
                android:id="@+id/link_install_manage"
                style="@style/Widget.DeepSeekHarness.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:text="@string/common_open_plugin_manager" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
