<?xml version="1.0" encoding="utf-8"?>
<!-- 诊断与日志：iOS 拟态分组排版（浅灰底 + 白色大圆角卡片 + 组标题在上） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad"
        android:paddingTop="@dimen/gap_tight"
        android:paddingBottom="@dimen/page_pad">

        <!-- 顶栏：返回 + 页面大标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/diagnostic_back"
                style="@style/Widget.DeepSeekHarness.ToolbarAction"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="‹"
                android:textSize="24sp"
                android:contentDescription="返回" />

            <TextView
                style="@style/DeepSeekHarnessText.PageTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_tight"
                android:text="诊断与日志" />
        </LinearLayout>

        <!-- 组标题：错误日志 -->
        <TextView
            style="@style/DeepSeekHarnessText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_hair"
            android:layout_marginTop="@dimen/gap_section"
            android:text="错误日志" />

        <LinearLayout
            style="@style/DeepSeekHarnessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight">

            <TextView
                style="@style/DeepSeekHarnessText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="日志收集" />

            <TextView
                style="@style/DeepSeekHarnessText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_hair"
                android:text="收集启动失败、崩溃和最近运行输出。下载后可在 Download/DeepSeekHarness 中找到。" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/diagnostic_logs_download"
                    style="@style/Widget.DeepSeekHarness.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/btn_height"
                    android:text="下载错误日志" />

                <Button
                    android:id="@+id/diagnostic_logs_save_as"
                    style="@style/Widget.DeepSeekHarness.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:text="另存为" />
            </LinearLayout>

            <TextView
                android:id="@+id/diagnostic_logs_status"
                style="@style/DeepSeekHarnessText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:minHeight="@dimen/touch_min"
                android:padding="@dimen/gap_tight"
                android:background="@color/raised"
                android:gravity="center_vertical"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- 组标题：环境 -->
        <TextView
            style="@style/DeepSeekHarnessText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_hair"
            android:layout_marginTop="@dimen/gap_section"
            android:text="环境" />

        <LinearLayout
            style="@style/DeepSeekHarnessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight">

            <TextView
                style="@style/DeepSeekHarnessText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="环境检查" />

            <TextView
                style="@style/DeepSeekHarnessText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_hair"
                android:text="检查运行环境、证书和插件状态。" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:layout_marginTop="@dimen/gap_control"
                android:background="@color/line" />

            <TextView
                android:id="@+id/diagnostic_status"
                style="@style/DeepSeekHarnessText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:lineSpacingExtra="2dp"
                android:text="" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/diagnostic_refresh"
                    style="@style/Widget.DeepSeekHarness.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/btn_height"
                    android:text="重新诊断" />

                <Button
                    android:id="@+id/diagnostic_repair"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:minHeight="@dimen/btn_height"
                    android:text="修复工具" />
            </LinearLayout>

            <Button
                android:id="@+id/diagnostic_plugins"
                style="@style/Widget.DeepSeekHarness.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:text="打开插件管理" />
        </LinearLayout>

        <!-- 组标题：报告 -->
        <TextView
            style="@style/DeepSeekHarnessText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_hair"
            android:layout_marginTop="@dimen/gap_section"
            android:text="报告" />

        <LinearLayout
            style="@style/DeepSeekHarnessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tight">

            <TextView
                style="@style/DeepSeekHarnessText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="诊断报告" />

            <TextView
                android:id="@+id/diagnostic_report"
                style="@style/DeepSeekHarnessText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textIsSelectable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
