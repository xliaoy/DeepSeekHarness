<?xml version="1.0" encoding="utf-8"?>
<!-- 诊断与日志：与官方页结构一致（错误日志 / 环境检查 / 反馈问题 / 诊断报告），
     UI 用 DeepSeekHarness 样式；诊断报告区用 LogScrollView 固定高度滚动，可上下滑动查看。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/diagnostic_page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad"
        android:paddingTop="@dimen/gap_tight"
        android:paddingBottom="@dimen/page_pad">

        <!-- 顶栏：返回 + 页面大标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/diagnostic_back"
                style="@style/Widget.DeepSeekHarness.ToolbarAction"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:contentDescription="@string/common_back"
                android:text="‹"
                android:textSize="24sp" />

            <TextView
                style="@style/DeepSeekHarnessText.PageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_tight"
                android:layout_weight="1"
                android:text="@string/diag_title" />
        </LinearLayout>

        <!-- 错误日志：下载 / 另存为 / 状态 -->
        <LinearLayout
            style="@style/DeepSeekHarnessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section">

            <TextView
                style="@style/DeepSeekHarnessText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diag_error_logs" />

            <TextView
                style="@style/DeepSeekHarnessText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:text="@string/diag_error_logs_desc" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/diagnostic_logs_download"
                    style="@style/Widget.DeepSeekHarness.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/btn_height"
                    android:text="@string/diag_download_logs" />

                <Button
                    android:id="@+id/diagnostic_logs_save_as"
                    style="@style/Widget.DeepSeekHarness.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:text="@string/common_save_as" />
            </LinearLayout>

            <TextView
                android:id="@+id/diagnostic_logs_status"
                style="@style/DeepSeekHarnessText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:background="@color/raised"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:padding="@dimen/gap_tight"
                android:textColor="@color/primary" />
        </LinearLayout>

        <!-- 环境检查：重新诊断 / 修复工具 / 打开插件管理 -->
        <LinearLayout
            style="@style/DeepSeekHarnessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section">

            <TextView
                style="@style/DeepSeekHarnessText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/env_check" />

            <TextView
                style="@style/DeepSeekHarnessText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:text="@string/env_check_desc" />

            <TextView
                android:id="@+id/diagnostic_status"
                style="@style/DeepSeekHarnessText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:lineSpacingExtra="2dp"
                android:text="" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/diagnostic_refresh"
                    style="@style/Widget.DeepSeekHarness.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/btn_height"
                    android:text="@string/diag_rerun" />

                <Button
                    android:id="@+id/diagnostic_repair"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_weight="1"
                    android:minHeight="@dimen/btn_height"
                    android:text="@string/diag_repair_tools" />
            </LinearLayout>

            <Button
                android:id="@+id/diagnostic_plugins"
                style="@style/Widget.DeepSeekHarness.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:text="@string/common_open_plugin_manager" />
        </LinearLayout>

        <!-- 反馈问题：补充复现步骤 + 复制 / 导出 -->
        <LinearLayout
            style="@style/DeepSeekHarnessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section">

            <TextView
                style="@style/DeepSeekHarnessText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diag_feedback" />

            <EditText
                android:id="@+id/diagnostic_steps"
                style="@style/DeepSeekHarnessText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="@string/diag_feedback_hint"
                android:inputType="textMultiLine"
                android:maxLength="2000"
                android:minHeight="80dp"
                android:padding="@dimen/card_pad" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_control"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/diagnostic_copy"
                    style="@style/Widget.DeepSeekHarness.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/btn_height"
                    android:text="@string/diag_copy_feedback" />

                <Button
                    android:id="@+id/diagnostic_export"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_weight="1"
                    android:minHeight="@dimen/btn_height"
                    android:text="@string/diag_export_report" />
            </LinearLayout>
        </LinearLayout>

        <!-- 诊断报告：LogScrollView 固定高度滚动区，可上下滑动查看 -->
        <LinearLayout
            style="@style/DeepSeekHarnessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:background="@drawable/bg_preview">

            <TextView
                style="@style/DeepSeekHarnessText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diag_report" />

            <com.deepseekharness.app.ui.LogScrollView
                android:id="@+id/diagnostic_report_scroll"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="@dimen/gap_control"
                android:fadeScrollbars="false"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/diagnostic_report"
                    style="@style/DeepSeekHarnessText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="1dp"
                    android:paddingEnd="@dimen/gap_tight"
                    android:textIsSelectable="true" />
            </com.deepseekharness.app.ui.LogScrollView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>